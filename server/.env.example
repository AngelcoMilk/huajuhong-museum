# 后端环境变量样例：复制成同目录的 .env 再按注释填值。
#   cp server/.env.example server/.env
# 这里只有占位值，真实密钥不要提交。

# ── 必填 ────────────────────────────────────────────────
# SQLite 库文件位置。相对路径以 prisma/ 为准：file:./dev.db 就是 server/prisma/dev.db
DATABASE_URL="file:./dev.db"

# 后台登录 token 的签名密钥，至少 16 个字符，换成随机串。
# 生成方法：openssl rand -base64 32
ADMIN_JWT_SECRET=""

# ── 生产环境必填 ────────────────────────────────────────
# 购物账号单独的 JWT 密钥，至少 16 个字符，不能和 ADMIN_JWT_SECRET 相同。
# 不填时开发环境会回落到 ADMIN_JWT_SECRET，NODE_ENV=production 下服务拒绝启动。
# 生成方法：openssl rand -base64 32
# SHOP_JWT_SECRET=""

# ── 可选：缺省时使用内置值 ───────────────────────────────
# 后台「模型供应商」里存的 API Key 用 AES-256-GCM 加密；这是加密密钥。
# 不填则回落到 ADMIN_JWT_SECRET。换掉它会让库里已存的 Key 解不开，需要重新填。
# 生成方法：openssl rand -base64 32
# SECRETS_KEY=""

# 首次建管理员用（npm run db:seed）。服务启动本身不读这两个值。
# ADMIN_PASSWORD 不填时 seed 会随机生成一个口令，只在终端打印一次。
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD=""

# 监听端口与地址。默认只绑回环（127.0.0.1）。
# PORT=3000
# HOST=127.0.0.1

# 由后端单端口托管 site/dist（生产部署用）；开发时留空。
# SERVE_SITE=1

# 讲解员内置模型的缺省供应商与模型（后台试聊、会话分析取不到库里的配置时用它兜底；
# 前台讲解员必须先有已发布版本，没有时统一提示「讲解服务暂时不可用，请稍后再试」）
# GUIDE_PROVIDER="deepseek"
# GUIDE_MODEL="deepseek-v4-flash"

# 知识库来源：json = 读切片文件（默认，用 server/kb/slices.json），sample = 用内置样例
# GUIDE_KB="json"
# 自定义切片文件位置
# GUIDE_KB_PATH="/绝对路径/slices.json"

# 额外允许跨域的前端来源，逗号分隔（默认已含 localhost:5173 / 4173 等）
# GUIDE_ALLOWED_ORIGINS="http://192.168.1.10:5173"

# pi 的模型表位置；不填用 pi 自己的配置目录（~/.pi/agent/models.json）
# PI_MODELS_PATH=""

# 打印 Prisma SQL 日志：1 打开
# PRISMA_LOG=""

# ── 讲解员限流与配额（都可省略，省略用括号里的默认值） ──
# 会话签名密钥；不填回落 ADMIN_JWT_SECRET，都没有则进程内随机（重启后旧会话全失效）
# GUIDE_SESSION_SECRET=""
# 每会话 10 分钟内的提问数（20）、每会话总条数（60）
# GUIDE_SESSION_MSG_LIMIT=20
# GUIDE_SESSION_TOTAL_LIMIT=60
# 每 IP 10 分钟提问数（40）、每天提问数（300）、10 分钟内新建会话数（10）
# GUIDE_IP_MSG_LIMIT=40
# GUIDE_IP_DAILY_LIMIT=300
# GUIDE_IP_SESSION_LIMIT=10
# 全站每天消息数（3000）与 token 数（5000000）
# GUIDE_DAILY_MESSAGE_LIMIT=3000
# GUIDE_DAILY_TOKEN_LIMIT=5000000
# 并发：同一会话（1）、每 IP（2）、全站（8）
# GUIDE_SESSION_CONCURRENCY=1
# GUIDE_IP_CONCURRENCY=2
# GUIDE_SITE_CONCURRENCY=8
# 内存里最多保留多少个讲解会话（256）
# MAX_SESSIONS=256

# ── 反向代理与 Cookie ───────────────────────────────────
# 前面有几层可信反向代理：0（默认）= 只信 socket，不看 X-Forwarded-For
# TRUST_PROXY_HOPS=0
# Cookie 的 Secure 属性：不填跟 NODE_ENV 走；1 强制开、0 强制关（本地 http 演示要关）
# COOKIE_SECURE=0
